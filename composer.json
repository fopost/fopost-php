{
  "name": "fopost/sdk",
  "description": "Official PHP SDK for the FoPost API.",
  "type": "library",
  "keywords": ["fopost", "sdk", "social-media", "api", "scheduling"],
  "homepage": "https://fopost.com",
  "license": "MIT",
  "authors": [
    {
      "name": "FoPost",
      "homepage": "https://fopost.com"
    },
    {
      "name": "Porter Bridge, LLC",
      "homepage": "https://fopost.com"
    }
  ],
  "support": {
    "issues": "https://github.com/fopost/fopost-php/issues",
    "docs": "https://fopost.com/docs",
    "source": "https://github.com/fopost/fopost-php"
  },
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "squizlabs/php_codesniffer": "^3.9"
  },
  "autoload": {
    "psr-4": {
      "Fopost\\Sdk\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Fopost\\Sdk\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "phpcs"
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
