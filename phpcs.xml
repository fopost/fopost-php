<?xml version="1.0"?>
<ruleset name="fopost-sdk">
  <description>Coding standard for fopost/sdk.</description>
  <file>src</file>
  <file>tests</file>
  <arg name="colors"/>
  <arg value="p"/>
  <rule ref="PSR12"/>
  <rule ref="Generic.Files.LineLength">
    <properties>
      <property name="lineLimit" value="120"/>
      <property name="absoluteLineLimit" value="140"/>
    </properties>
  </rule>
</ruleset>
